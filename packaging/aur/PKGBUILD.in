# Maintainer: Metamorfolog <https://github.com/Metamorfolog>
# Generated by CI from packaging/aur/PKGBUILD.in – edit the template, not the AUR copy.
pkgname=fileaction-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Convert files by dropping them on a radial wheel: images, audio, video, PDF, documents, spreadsheets, archives"
arch=('x86_64')
url="https://github.com/Metamorfolog/file_action"
license=('@LICENSE@')
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'fontconfig' 'libx11' 'libxi' 'libxrandr' 'libxcursor' 'libice' 'libsm')
optdepends=(
  'ffmpeg: audio and video conversions'
  'pandoc-cli: document conversions (DOCX, Markdown, EPUB, …)'
  'libreoffice-fresh: Office files and export to PDF'
  'tesseract: extract text from images (OCR)'
  'tesseract-data-eng: English OCR'
  'tesseract-data-ces: Czech OCR'
)
provides=('fileaction')
conflicts=('fileaction')
options=('!strip' '!debug')
source=("@SOURCE@")
sha256sums=('@SHA256@')

package() {
  install -d "$pkgdir/opt/fileaction" "$pkgdir/usr/bin"
  cp -a fileaction/app/. "$pkgdir/opt/fileaction/"
  ln -s /opt/fileaction/fileaction "$pkgdir/usr/bin/fileaction"
  install -Dm644 fileaction/share/fileaction.desktop "$pkgdir/usr/share/applications/fileaction.desktop"
  install -Dm644 fileaction/share/fileaction.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/fileaction.png"
  install -Dm755 fileaction/share/dolphin-servicemenu.desktop "$pkgdir/usr/share/kio/servicemenus/fileaction.desktop"
  install -Dm644 fileaction/share/fileaction.nemo_action "$pkgdir/usr/share/nemo/actions/fileaction.nemo_action"
}
