<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FileAction</AssemblyName>
    <RootNamespace>FileAction.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FileAction.ico</ApplicationIcon>
    <StartupObject>FileAction.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>cs;en</SatelliteResourceLanguages>
    <Product>FileAction</Product>
    <Description>Převod souborů přetažením na kruhové menu</Description>
    <!-- ThemeMode (Fluent) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous; WinForms is only used for the tray icon and shell copy dialogs. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\FileAction.ico" />
    <Resource Include="Assets\FileAction.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileAction.Core\FileAction.Core.csproj" />
  </ItemGroup>

</Project>
