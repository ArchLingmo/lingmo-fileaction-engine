<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lingmo fork only (see LINGMO.md): the conversions as a small console program, without the Avalonia window,
    so the Lingmo desktop can drive them (lingmo-fileaction-engine list/run - -json). The settings, presets and
    OCR come from FileAction.Linux as linked files, so upstream changes reach this program without copies.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>lingmo-fileaction-engine</AssemblyName>
    <RootNamespace>FileAction.Lingmo</RootNamespace>
    <Version>1.13.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FileAction.Linux\LinuxSettings.cs" Link="Linked\LinuxSettings.cs" />
    <Compile Include="..\FileAction.Linux\LinuxOperations.cs" Link="Linked\LinuxOperations.cs" />
    <Compile Include="..\FileAction.Linux\TesseractOcr.cs" Link="Linked\TesseractOcr.cs" />
    <Compile Include="..\FileAction.Linux\Shell\RecentResults.cs" Link="Linked\RecentResults.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileAction.Core\FileAction.Core.csproj" />
  </ItemGroup>
</Project>
